# Anthropic API key — required for /api/query and /api/assets/generate
ANTHROPIC_API_KEY=

# Model for PMM generation work. Default: claude-opus-4-8
PMM_MODEL=claude-opus-4-8

# Absolute path to the GTM War Room. Default: ../../GTM-War-Room relative to app/backend
WAR_ROOM_DIR=

PORT=3001

# Supabase (optional — app runs file-only without these).
# From supabase.com dashboard → Project Settings → API.
# Backend-only secrets: never commit, never expose to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
